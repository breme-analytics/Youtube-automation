# Copy this file to .env (same folder) and paste your keys into .env.
# .env is git-ignored: never commit it, share it, or paste keys into a chat.
# In GitHub Actions or Codespaces, add the same names as secrets instead.

# Stock footage (videos and photos). After logging in, the key is shown at
# https://pixabay.com/api/docs/#api_support
PIXABAY_API_KEY=

# Script writing. Both are free; the bot switches to the other when one hits its daily limit.
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter (free models only, no card needed): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cloudflare. Two different tokens:
# - CLOUDFLARE_AI_TOKEN: Workers AI (images, and the last text fallback). Dashboard > AI > Workers AI >
#   "Use REST API" > Create a Workers AI API Token (permissions "Workers AI: Read" and "Workers AI: Edit").
# - CLOUDFLARE_API_TOKEN and the S3 keys: R2 storage for finished videos (download links for long videos).
#   R2 > Manage API tokens.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_S3_API_ENDPOINT=
