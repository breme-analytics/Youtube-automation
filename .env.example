# Copy this file to .env (same folder) and paste your keys into .env, for running on a computer.
# .env is git-ignored: never commit it, share it, or paste keys into a chat.
# On GitHub Actions, add the same names as repository secrets instead (docs/DEPLOY.md).

# Stock footage (videos and photos). After logging in, the key is shown at
# https://pixabay.com/api/docs/#api_support
PIXABAY_API_KEY=

# Script writing, with free models only. OpenRouter is tried first: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Google AI Studio (free): checks each picture matches the narration; script fallback.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional, for sharper paintings (Cloudflare Workers AI, free 10,000 neurons a day). Without it the bot uses
# Pollinations, which needs no key. Dashboard > AI > Workers AI > "Use REST API" > Create a Workers AI API Token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Only for automatic posting (channel.toml [schedule] mode = "auto"), after YouTube's API audit.
# A "TVs and Limited Input devices" OAuth client from Google Cloud; then run: python -m owd youtube-login
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
